HOST=0.0.0.0
SERVER_PORT=3000
SELLER_PORT=3001
CONSUMER_PORT=3002
# Use the exact seller/consumer origins in production, e.g.
# CORS_ORIGIN=https://seller.example.com,https://shop.example.com
CORS_ORIGIN=*
DATA_FILE=./data/db.json

# --- WeChat mini program build-time env (consumed by Taro via dotenv) ---
# Copy this file to .env.development and/or .env.production, then set:
# TARO_APP_API_BASE=http://localhost:3000            # development
# TARO_APP_API_BASE=https://api.your-domain.example  # production (no trailing slash)

# --- WeChat miniprogram-ci (npm run ci:upload / ci:preview, handled by scripts/ci.js) ---
# WEAPP_APPID=wx0123456789abcdef     # override appid without editing project.config.json
# WEAPP_PRIVATE_KEY=./private.key    # CI key downloaded from mp.weixin.qq.com (git-ignored)
# WEAPP_DIST=./dist                  # build output dir to upload
